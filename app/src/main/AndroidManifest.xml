<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PizzaApp">

        <activity
            android:name=".activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <activity android:name=".activity.RegisterActivity" />

        <activity
            android:name=".activity.FoodDetailActivity"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.CartActivity"
            android:parentActivityName=".activity.MainActivity"
            android:label="Your Cart" />

        <activity
            android:name=".activity.OrderDetailActivity"
            android:parentActivityName=".activity.MainActivity"
            android:label="Order Details" />
        <activity android:name=".activity.AdminActivity" />
        <activity android:name=".activity.AdminFoodActivity" />
        <activity android:name=".activity.AdminOrderActivity" />
        <activity android:name=".activity.AdminUserActivity" />


    </application>


</manifest>